# Copy to .env — every setting is read from the environment.
APP_ENV=development
LOG_LEVEL=info

POSTGRES_USER=bordroplus
POSTGRES_PASSWORD=bordroplus_dev_password
POSTGRES_DB=bordroplus

DB_MAX_CONNS=20
HTTP_REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=15s
CORS_ORIGINS=http://localhost:3000

# Authentication. JWT_SECRET signs access tokens (HS256, >= 32 bytes).
# Generate your own for anything beyond local demo: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
# false only because the demo runs on plain http://localhost; set true behind HTTPS.
COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT=15m

# Demo accounts (one per role) are created on startup with this password.
SEED_DEMO=true
DEMO_PASSWORD=Demo.2026!
